# Copia este archivo a .env (nunca subas .env). Todo funciona sin Internet ni API key.

# Proveedor del LLM: auto | gemini | ollama | none
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Identidad del nodo y vecinos (topología A <-> B <-> C)
SARD_NODE_ID=A
SARD_PEERS=

# Tipos de pregunta de seguimiento que muestra la PWA: si_no | opciones | texto (por coma)
SARD_QUESTION_KINDS=si_no

# Radio VHF (D7): auto | whisper | none. auto usa faster-whisper si el modelo ya está en
# data/models/whisper-<modelo> (python -m guadua.radio descargar-modelo small); nunca descarga
# al arrancar. Sin transcriptor, el operador escribe el texto de los clips en el tablero.
SARD_TRANSCRIBER=auto
WHISPER_MODEL=small
WHISPER_THREADS=2
